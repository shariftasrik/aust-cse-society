@model List<User>

<main id="site__main" class="2xl:ml-[--w-side]  xl:ml-[--w-side-sm] p-2.5 h-[calc(100vh-var(--m-top))] mt-[--m-top]">
    <div class="max-w-[1065px] mx-auto">
        <h2 class="text-xl font-bold mb-4">Members</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var user in Model)
            {
                <a asp-controller="Users" asp-action="Details" asp-route-userId="@user.Id"
                   class="bg-white rounded-xl shadow-sm p-4 flex items-center gap-3">
                    <img src="@Url.Content("~/images/avatar/user.png")" class="w-12 h-12 rounded-full" />
                    <div>
                        <div class="font-medium text-black">@user.FullName</div>
                        <div class="text-sm text-gray-500">@user.Email</div>
                    </div>
                </a>
            }
        </div>
        @if (Model.Count == 0)
        {
            <p class="text-gray-500">No other members yet. Register a second account to see this list.</p>
        }
    </div>
</main>