@model AustCseApp.ViewModels.Users.UserProfileVM

<main id="site__main" class="2xl:ml-[--w-side]  xl:ml-[--w-side-sm] p-2.5 h-[calc(100vh-var(--m-top))] mt-[--m-top]">
    <div class="max-w-[1065px] mx-auto max-lg:-m-2.5">
        <div class="bg-white shadow lg:rounded-b-xl lg:-mt-10">
            <div class="relative overflow-hidden w-full lg:h-8 h-8"></div>
            <div class="p-3 flex flex-row items-center">
                <div class="flex-shrink-0 mr-4">
                    <div class="relative lg:h-28 lg:w-28 w-28 h-28">
                        <div class="relative overflow-hidden rounded-full md:border-[6px] border-gray-100 shrink-0">
                            <img src="@(!string.IsNullOrEmpty(Model.ProfileUser.ProfilePictureUrl) && !Model.ProfileUser.ProfilePictureUrl.StartsWith("http")
                                                            ? Url.Content("~/" + Model.ProfileUser.ProfilePictureUrl)
                                                            : (string.IsNullOrEmpty(Model.ProfileUser.ProfilePictureUrl) || Model.ProfileUser.ProfilePictureUrl.StartsWith("http")
                                                                ? Url.Content("~/images/avatar/user.png")
                                                                : Model.ProfileUser.ProfilePictureUrl))" />
                        </div>
                    </div>
                </div>
                <div>
                    <h3 class="md:text-3xl text-base font-bold text-black">@Model.ProfileUser.FullName</h3>
                    <p class="mt-2 text-gray-500">@Model.ProfileUser.Email</p>
                    <p class="mt-1 text-gray-600">@Model.ProfileUser.AccountKind · batch @Model.ProfileUser.Batch · @Model.ProfileUser.VerificationStatus @(string.IsNullOrEmpty(Model.ProfileUser.Company) ? "" : "· " + Model.ProfileUser.Company)</p>
                    @if (!string.IsNullOrEmpty(Model.ProfileUser.Bio))
                    {
                        <p class="mt-2 text-gray-600">@Model.ProfileUser.Bio</p>
                    }
                </div>
            </div>
        </div>
        <div class="flex 2xl:gap-12 gap-10 mt-8 max-lg:flex-col" id="js-oversized">
            <div class="flex-1 xl:space-y-6 space-y-3">
                @if (Model.Posts.Count == 0)
                {
                    <div class="bg-white rounded-xl shadow-sm p-4">No posts to show.</div>
                }
                else
                {
                    @foreach (var post in Model.Posts)
                    {
                        <partial name="Home/_Post" model="post"
                                 view-data='new ViewDataDictionary(ViewData)
                                 {
                                     { "ShowAllComment", false },
                                     { "ShowDetails", false }
                                 }' />
                    }
                }
            </div>
        </div>
    </div>
</main>