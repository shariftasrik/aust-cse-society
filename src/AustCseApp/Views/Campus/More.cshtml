<main id="site__main" class="2xl:ml-[--w-side] xl:ml-[--w-side-sm] p-2.5 h-[calc(100vh-var(--m-top))] mt-[--m-top]">
    <div class="max-w-[1065px] mx-auto">
        <h2 class="text-xl font-bold mb-4">More</h2>
        <div class="grid sm:grid-cols-2 gap-4">
            <a asp-action="StudyMaterials" class="bg-white rounded-xl shadow-sm p-5 block">
                <h3 class="font-semibold">Study Materials</h3>
                <p class="text-sm text-gray-500 mt-1">Notes and resources</p>
            </a>
            <a asp-action="VideoArchive" class="bg-white rounded-xl shadow-sm p-5 block">
                <h3 class="font-semibold">Video Archive</h3>
                <p class="text-sm text-gray-500 mt-1">Recorded sessions</p>
            </a>
            <a asp-action="Quiz" class="bg-white rounded-xl shadow-sm p-5 block">
                <h3 class="font-semibold">Quiz</h3>
                <p class="text-sm text-gray-500 mt-1">Practice quizzes</p>
            </a>
        </div>
    </div>
</main>