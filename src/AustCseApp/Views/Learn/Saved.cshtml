@model List<LearningResource>
<main class="ac-main">
    <div class="ac-wrap">
        <p class="ac-kicker">Saved</p>
        <h1 class="ac-title">Resources you kept</h1>
        <div class="ac-card" style="margin-top:16px">
            @if (Model.Count == 0)
            {
                <p class="ac-muted">Save a video, paper, or note from a course page.</p>
            }
            @foreach (var item in Model)
            {
                <div class="ac-row">
                    <div>
                        <div class="ac-kicker">@item.Kind · @item.Course.Code</div>
                        <a asp-action="Course" asp-route-id="@item.CourseId">@item.Title</a>
                    </div>
                </div>
            }
        </div>
    </div>
</main>
