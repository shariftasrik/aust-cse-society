@model BatchPageVM
<main class="ac-main">
    <div class="ac-wrap">
        <p class="ac-kicker">Your batch</p>
        <h1 class="ac-title">@(string.IsNullOrWhiteSpace(Model.Me.Batch) ? "Set your batch" : $"Batch {Model.Me.Batch}")</h1>
        <p class="ac-muted">Notices, questions, and updates for this batch. @Model.Me.VerificationStatus</p>

        @if (TempData["BatchError"] != null)
        {
            <div class="ac-banner warn">@TempData["BatchError"]</div>
        }

        @if (Model.Me.VerificationStatus != VerificationStatus.Verified)
        {
            <div class="ac-banner">Posting opens after an admin verifies your account. You can still open Learn and Careers.</div>
        }
        else if (string.IsNullOrWhiteSpace(Model.Me.Batch))
        {
            <div class="ac-banner warn">Add your batch in Settings. Posts land on that batch page.</div>
        }
        else
        {
            <form asp-controller="Home" asp-action="CreatePost" method="post" enctype="multipart/form-data" class="ac-card ac-form" style="margin-top:16px">
                <label>Update<textarea name="content" rows="3" placeholder="What should your batch know?"></textarea></label>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:10px">
                    <label>Kind
                        <select name="postKind">
                            <option value="Notice">Notice</option>
                            <option value="Question">Question</option>
                            <option value="ResourceTip">Resource tip</option>
                            <option value="General" selected>General update</option>
                        </select>
                    </label>
                    <label>Image<input type="file" name="image" accept="image/png,image/jpeg" /></label>
                </div>
                <button class="ac-btn" style="margin-top:12px" type="submit">Post to batch @Model.Me.Batch</button>
            </form>
        }

        <div style="margin-top:16px" class="space-y-3">
            @if (Model.Posts.Count == 0)
            {
                <div class="ac-card">No posts on this batch yet.</div>
            }
            else
            {
                foreach (var post in Model.Posts)
                {
                    <partial name="Home/_Post" model="post" view-data='new ViewDataDictionary(ViewData) { { "ShowAllComment", false }, { "CanPin", Model.CanPin } }' />
                }
            }
        </div>
    </div>
</main>
<partial name="Home/_PostDeleteConfirmation" />
<script>
    function openPostDeleteConfirmation(postId) {
        UIkit.dropdown('.post-options-dropdown').hide();
        document.getElementById('deleteConfirmationPostId').value = postId;
        UIkit.modal('#postDeleteDialog').show();
    }
</script>
